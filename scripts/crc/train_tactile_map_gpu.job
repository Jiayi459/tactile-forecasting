#!/bin/bash
# UGE job: train the tactile-MAP -> F/CoP forecaster sweep (flatten + CNN x history {1,3,10 s}) on
# ND CRC GPU. Same model/target/split/harness as the local run, just full training on GPU + all data.
#
# Prereqs on CRC (once): the raw maps must exist at ~/actionsense/states/clip_*.npy (from
# scripts/crc/stream_actionsense.sh with --save-clips-for "Pour,Slice,Peel"). state_N.npy + manifest
# + splits.json are already committed in the repo. This job SYMLINKS the clips into the repo data dir.
#
# Submit from repo root after `git pull` and `mkdir -p logs`:
#   qsub scripts/crc/train_tactile_map_gpu.job
#   qsub -v EPOCHS=80 scripts/crc/train_tactile_map_gpu.job
# 5-fold probabilistic CV -> docs/actionsense/tactile_map_cv_results.csv (skill + coverage). Plot locally.
# NOTE: no inline comments on #$ lines.
#$ -M jhao3@nd.edu
#$ -m abe
#$ -q gpu
#$ -l gpu_card=1
#$ -pe smp 4
#$ -N tactile_map
#$ -cwd
#$ -o logs/
#$ -e logs/

set -euo pipefail
conda activate tactile

# CLI needs pyyaml/numpy/torch (torch has CUDA in this env); scoring deps are NOT needed here.
python -c "import yaml" 2>/dev/null || pip install pyyaml --quiet

# Everything the harness reads, not only the maps. This used to link clip_*.npy alone, on the
# stated assumption that "state_N.npy + manifest.jsonl + splits.json are already committed
# there" -- git tracks none of those three, so the job built a directory holding a hundred
# symlinks and no index, then died 45 s later inside splits.py with a bare FileNotFoundError
# (2026-09-01). Link the lot, then say so plainly if the index is still missing.
SRC="$HOME/actionsense/states"
mkdir -p data/actionsense_states
n=0
for f in "$SRC"/clip_*.npy "$SRC"/state_*.npy "$SRC"/manifest.jsonl "$SRC"/splits.json; do
    [ -e "$f" ] && ln -sf "$f" data/actionsense_states/ && n=$((n+1))
done
echo "linked $n files from $SRC into data/actionsense_states/"

test -f data/actionsense_states/manifest.jsonl || {
    echo "FATAL: data/actionsense_states/manifest.jsonl missing after linking from $SRC."
    echo "  The harness reads the manifest to build splits, so nothing downstream can run."
    echo "  Check that $SRC holds manifest.jsonl (and state_*.npy); it is NOT in git."
    exit 1
}

echo "Host: $(hostname)  JOB_ID: ${JOB_ID:-NA}  started $(date)"
python -c "import torch; print('CUDA available:', torch.cuda.is_available())"

# torch.use_deterministic_algorithms needs this before cuBLAS is reproducible on CUDA >= 10.2.
# Measured cost of omitting it, on the OpenTouch map arms: up to 4.9e-3 of skill between two
# runs with identical seed and data (SESSION_LOG 2026-08-23).
export CUBLAS_WORKSPACE_CONFIG=:4096:8

# tests/ in full before anything trains, so a broken fork fails in seconds rather than after
# hours. The hand-listed subset this replaced on the OpenTouch job had let a wrong assertion
# sit unexecuted through an entire run.
python -m pytest tests/ -q

python -u scripts/actionsense/train_tactile_map.py \
    --epochs "${EPOCHS:-80}" --folds "${FOLDS:-5}" \
    ${BACKBONE:+--backbone "$BACKBONE"} \
    ${SCOPE:+--scope "$SCOPE"} \
    ${ENCODERS:+--encoders "$ENCODERS"} \
    ${HISTORIES:+--histories "$HISTORIES"} \
    ${SAVE_PREDS:+--save-preds "$SAVE_PREDS"} \
    ${CSV:+--csv "$CSV"}

echo ""
echo "finished $(date)"
echo "[done] 5-fold CV skill + coverage -> docs/actionsense/tactile_map_cv_results.csv"
echo "Pull to local + plot:"
echo "  scp -J jhao3@bastion.crc.nd.edu jhao3@crcfe01.crc.nd.edu:~/TouchAnything/docs/actionsense/tactile_map_cv_results.csv docs/"
echo "  python scripts/actionsense/plot_tactile_map.py"
